# Copy to .env and fill in your own keys (never commit `.env` to git)
# General keys
TAVILY_API_KEY=your_tavily_api_key_here

# Use native Google Gemini (set this to use Gemini; takes precedence)
#GEMINI_API_KEY=your_gemini_api_key_here

# Use an OpenAI-compatible provider (OpenAI, OpenRouter, Deepseek, etc.)
# If using OpenRouter, set `OPENAI_API_BASE` to a host containing `openrouter.ai`
OPENAI_API_KEY=your_openai_or_openrouter_key_here
OPENAI_API_BASE=            # e.g. https://api.openrouter.ai  (leave empty to use official OpenAI)
OPENAI_MODEL=gpt-4o         # optional; when OPENAI_API_BASE contains openrouter.ai the app will prefix with `openrouter/`

# Notes:
# - If `GEMINI_API_KEY` is present and non-empty the app will select Gemini
#   and ignore `OPENAI_*` vars. Comment out `GEMINI_API_KEY` to use OpenAI/OpenRouter.
# - Keep real keys in your local `.env`; do not commit secrets to the repository.
